{
  "name": "mau-launcher",
  "version": "0.2.0",
  "description": "Centro de aplicaciones de Mau para Windows, macOS y Linux",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mau.launcher",
    "productName": "Mau Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Mau Software <144965872+yetsin7@users.noreply.github.com>"
    }
  },
  "author": {
    "name": "Mau Software",
    "email": "144965872+yetsin7@users.noreply.github.com"
  }
}
